.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.tran 10n 1m
.end
* 72V to 12V Buck Converter
Vin in 0 72
M1 in gate sw 0 NMOS W=2 L=1
D1 0 sw DIODE
L1 sw out 100u
C1 out 0 100u
Rload out 0 1
Vgate gate 0 PULSE(0 12 0 1n 1n 1.66667e-05 0.01)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.tran 10n 1m
.end

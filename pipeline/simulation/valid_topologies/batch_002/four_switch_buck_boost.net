* Four-Switch Buck-Boost Converter
.tran 1n 5m

Vin in 0 12
M1 a in gate_a 0 NMOS W=100u L=1u
M2 0 a gate_b 0 NMOS W=100u L=1u
L1 a b 100u
M3 b out gate_c 0 NMOS W=100u L=1u
M4 0 b gate_d 0 NMOS W=100u L=1u
C1 out 0 100u
Rload out 0 10

Vgate_a gate_a 0 PULSE(0 12 0 1n 1n 5u 10u)
Vgate_b gate_b 0 PULSE(12 0 0 1n 1n 5u 10u)
Vgate_c gate_c 0 PULSE(0 12 0 1n 1n 5u 10u)
Vgate_d gate_d 0 PULSE(12 0 0 1n 1n 5u 10u)

.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)

.end
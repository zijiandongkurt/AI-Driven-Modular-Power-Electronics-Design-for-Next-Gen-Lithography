* Synchronous Buck Converter
.tran 1n 5m

Vin in 0 12
M1 sw in gate_hi 0 NMOS W=100u L=1u
M2 0 sw gate_lo 0 NMOS W=100u L=1u
L1 sw out 100u
C1 out 0 100u
Rload out 0 10

Vgate_hi gate_hi 0 PULSE(0 12 0 1n 1n 5u 10u)
Vgate_lo gate_lo 0 PULSE(12 0 0 1n 1n 5u 10u)

.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)

.end
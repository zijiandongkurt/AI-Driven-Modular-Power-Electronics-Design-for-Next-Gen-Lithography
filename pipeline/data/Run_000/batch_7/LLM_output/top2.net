* top2
.tran 1u 10m
Vin in 0 24
L1 in sw 100u
M1 sw gate 0 0 NMOS W=1000 L=1
C1 sw sw2 220u
L2 sw2 0 100u
D1 sw2 out DIODE
C2 out 0 1000u
Rload out 0 0.278
Vgate gate 0 PULSE(0 12 0 1n 1n 1.72u 10u)
Rdummy1 in 0 1e9
Rdummy2 sw 0 1e9
Rdummy3 sw2 0 1e9
Rdummy4 gate 0 1e9
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D(Is=1e-3 N=0.01)
.save V(*) I(*)
.end
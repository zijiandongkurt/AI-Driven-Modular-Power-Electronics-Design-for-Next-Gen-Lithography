* 220V to 12V async buck, 300W, 100kHz
* D=12/220=0.0545, t_on=545n, Rload=144/300=0.48
Vin in 0 220
M1 in gate sw 0 NMOS W=1 L=1
D1 0 sw DIODE
L1 sw out 47u
C1 out 0 470u
Rload out 0 0.48
Vgate gate 0 PULSE(0 12 0 1n 1n 545n 10u)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.tran 1n 5m
.probe V(*) I(*)
.end

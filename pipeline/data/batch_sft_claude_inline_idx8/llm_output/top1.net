* 12V to 400V boost, 500W, 100kHz
* D=1-12/400=0.97, t_on=9.7u, Rload=400^2/500=320
Vin in 0 12
L1 in sw 100u
M1 sw gate 0 0 NMOS W=1 L=1
D1 sw out DIODE
C1 out 0 220u
Rload out 0 320
Rbleed sw 0 1Meg
Vgate gate 0 PULSE(0 12 0 1n 1n 9.7u 10u)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.tran 1n 5m
.probe V(*) I(*)
.end

.tran 1n 10m
Vin in 0 12
M1 in gate1 sw1 0 NMOS W=1 L=1
M2 in gate2 sw2 0 NMOS W=1 L=1
D1 0 sw1 DIODE
D2 0 sw2 DIODE
L1 sw1 out 20u
L2 sw2 out 20u
C1 out 0 100n
Rload out 0 8.333
Vgate1 gate1 0 PULSE(0 12 0 1n 1n 6.66667e-06 1e-05)
Vgate2 gate2 0 PULSE(0 12 0 1n 1n 6.66667e-06 1e-05)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
Rbleed sw1 0 1Meg
Rbleed sw2 0 1Meg
.end

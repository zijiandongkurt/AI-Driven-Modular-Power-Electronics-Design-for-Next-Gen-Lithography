.tran 1n 5m
Vin in 0 27.2727
M1 in gate sw 0 NMOS W=2 L=1
M2 gate2 0 sw 0 NMOS W=1 L=1
D1 0 sw DIODE
D2 gate2 0 DIODE
L1 sw out 100u
C1 out 0 150u
Rload out 0 0.83333
Vgate gate 0 PULSE(0 27.2727 0 1n 1n 4.16667e-06 1e-05)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
Rbleed Rload 0 1Meg
Rbleed gate 0 1Meg
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.end

* 280V to 24V synchronous buck, 500W
* D=24/280=0.0857, t_on=857n for T=10u
Vin in 0 280
M1 in gate sw 0 NMOS W=1 L=1
M2 sw gate2 0 0 NMOS W=1 L=1
L1 sw out 68u
C1 out 0 220u
Rload out 0 1.152
Rbleed sw 0 1Meg
Vgate  gate  0 PULSE(0 12 0    1n 1n 857n  10u)
Vgate2 gate2 0 PULSE(0 12 1.5u 1n 1n 8.0u  10u)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.tran 1n 5m
.end

* 250V to 12V interleaved 2-phase buck, 300W
Vin in 0 250
M1 in gate1 sw1 sw1 NMOS W=1 L=1
M2 in gate2 sw2 sw2 NMOS W=1 L=1
D1 0 sw1 DIODE
D2 0 sw2 DIODE
L1 sw1 out 47u
L2 sw2 out 47u
C1 out 0 100u
Rload out 0 0.48
Vgate1 gate1 sw1 PULSE(0 12 0 1n 1n 5.8u 10u)
Vgate2 gate2 sw2 PULSE(0 12 5.8u 1n 1n 5.8u 10u)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.tran 10n 1m
.save V(*) I(*)
.end
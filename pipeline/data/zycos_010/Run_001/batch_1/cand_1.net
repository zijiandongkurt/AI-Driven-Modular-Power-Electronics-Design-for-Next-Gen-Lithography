* 280V to 15V SEPIC, 350W
Vin in 0 280
L1 in sw1 100u
M1 sw1 gate1 0 0 NMOS W=1 L=1
C1 sw1 sw2 22u
L2 sw2 0 100u
M2 sw2 gate2 0 0 NMOS W=1 L=1
D1 sw2 out DIODE
C2 out 0 220u
Rload out 0 0.643
Rbleed sw1 0 1Meg
Rbleed1 sw2 0 1Meg
Vgate1 gate1 0 PULSE(0 12 0 1n 1n 5.8u 10u)
Vgate2 gate2 0 PULSE(0 12 0 1n 1n 5.8u 10u)
.model NMOS NMOS(Vto=1 Kp=2 Lambda=0)
.model DIODE D
.tran 10n 1m
.save V(*) I(*)
.end